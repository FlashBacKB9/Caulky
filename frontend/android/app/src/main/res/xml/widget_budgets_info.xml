<?xml version="1.0" encoding="utf-8"?>
<!-- Cómo van tus presupuestos: desde 1x1 (solo la cifra) hasta el tamaño que quieras (con filas) -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="app.caulky.mobile.WidgetConfigActivity"
    android:description="@string/widget_budgets_description"
    android:initialLayout="@layout/widget_card"
    android:previewLayout="@layout/widget_card"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
